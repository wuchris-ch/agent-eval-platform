{
  "$defs": {
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "provenance": {
          "default": "unavailable",
          "enum": [
            "producer_reported",
            "independently_observed",
            "unavailable"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reserved invocation without a candidate remains in the study denominator.",
  "properties": {
    "execution_id": {
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Execution Id",
      "type": "string"
    },
    "reason": {
      "enum": [
        "budget_exhausted",
        "timeout",
        "transport_error",
        "invalid_output",
        "verification_failed",
        "cancelled",
        "producer_error"
      ],
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-eval.production-failure/v2",
      "default": "agent-eval.production-failure/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "trial_ticket_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trial Ticket Sha256",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "execution_id",
    "trial_ticket_sha256",
    "reason"
  ],
  "title": "ProductionFailure",
  "type": "object"
}
