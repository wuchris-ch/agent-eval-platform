# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# macOS directory metadata. These are untracked files inside the harness
# worktree, so Finder rewriting one mid-run changes the attestation worktree
# digest and fails run verification.
.DS_Store

# Virtual environments
.venv

# eval artifacts
runs/
graphify-out/
review-agent-eval.json
.pytest_cache/
.ruff_cache/

# Local-only operator instructions. May contain private integration details.
/AGENTS.md

# Local-only PR watch list. May contain private repository names.
/.review-repositories
